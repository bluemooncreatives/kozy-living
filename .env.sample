COMPANY_NAME='Company Name'
TWITTER_CREATOR='Social Handle'
TWITTER_SITE='Link'
SITE_NAME='Store Name'
SHOPIFY_REVALIDATION_SECRET='Random Secret'
SHOPIFY_STOREFRONT_ACCESS_TOKEN='Shopify Key'
SHOPIFY_STORE_DOMAIN='shopify admin srote domain'
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID='Customer Account API client ID'
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN='Server-only private Storefront token'
# Admin credentials for the app that owns the contact form (write_metaobjects
# + read_metaobjects). Server-only — never expose either path.
#
# Classic custom app (permanent token, shown once in Shopify Admin):
SHOPIFY_ADMIN_ACCESS_TOKEN='shpat_...'
# Dev Dashboard app (no permanent token — exchanged server-side for one that
# expires every ~24h, see src/lib/shopify/admin.ts):
SHOPIFY_ADMIN_CLIENT_ID='Dev Dashboard app client ID'
SHOPIFY_ADMIN_CLIENT_SECRET='Dev Dashboard app client secret'
# Must be an HTTPS origin registered as a Callback URI in Shopify Admin ->
# Headless -> Customer Account API. Production: the live domain. Local: an
# HTTPS tunnel origin (Shopify rejects http:// and localhost).
NEXT_PUBLIC_SITE_URL='https://your-storefront-domain.com'
